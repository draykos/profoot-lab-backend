{
  "kind": "collectionType",
  "collectionName": "squadre",
  "info": {
    "singularName": "squadra",
    "pluralName": "squadre",
    "displayName": "Squadra",
    "description": "Anagrafica di una squadra: quella dell'atleta o un'avversaria nel calendario partite."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "nome": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "nomeBreve": {
      "type": "string"
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "citta": {
      "type": "string"
    },
    "stadio": {
      "type": "string"
    },
    "isMiaSquadra": {
      "type": "boolean",
      "default": false
    },
    "atleti": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::atleta.atleta",
      "mappedBy": "squadra"
    }
  }
}
