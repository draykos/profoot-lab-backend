{
  "kind": "collectionType",
  "collectionName": "allenamenti",
  "info": {
    "singularName": "allenamento",
    "pluralName": "allenamenti",
    "displayName": "Allenamento",
    "description": "Sessione video di allenamento assegnata a un singolo atleta per un giorno specifico."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "atleta": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::atleta.atleta",
      "inversedBy": "allenamenti"
    },
    "titolo": {
      "type": "string",
      "required": true
    },
    "descrizione": {
      "type": "text"
    },
    "categoria": {
      "type": "enumeration",
      "enum": [
        "forza",
        "attivazione",
        "defaticamento",
        "velocita",
        "core",
        "condizionamento",
        "recupero"
      ]
    },
    "durataMinuti": {
      "type": "integer",
      "min": 1
    },
    "intensita": {
      "type": "enumeration",
      "enum": ["alta", "media", "bassa"]
    },
    "data": {
      "type": "date",
      "required": true
    },
    "video": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["videos"]
    },
    "copertina": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    }
  }
}
