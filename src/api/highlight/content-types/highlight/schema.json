{
  "kind": "collectionType",
  "collectionName": "highlights",
  "info": {
    "singularName": "highlight",
    "pluralName": "highlights",
    "displayName": "Highlight",
    "description": "Clip video di un atleta dalle partite: gol, assist, azioni difensive."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "atleta": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::atleta.atleta",
      "inversedBy": "highlights"
    },
    "titolo": {
      "type": "string",
      "required": true
    },
    "data": {
      "type": "date",
      "required": true
    },
    "durataSecondi": {
      "type": "integer",
      "min": 0
    },
    "tipo": {
      "type": "enumeration",
      "enum": ["gol", "assist", "azione_difensiva", "dribbling", "parata"]
    },
    "avversario": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::squadra.squadra"
    },
    "partita": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::partita.partita"
    },
    "copertina": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "clip": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["videos"],
      "required": true
    },
    "inEvidenza": {
      "type": "boolean",
      "default": false
    }
  }
}
