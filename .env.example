HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Set to true when running behind a reverse proxy that terminates TLS (e.g. Render).
IS_PROXIED=false

# Bunny.net storage zone used as the media library upload provider — same zone
# for every environment (so files persist across deploys instead of living on
# Render's ephemeral disk), but each environment uploads into its own
# subfolder via BUNNY_UPLOAD_PATH so localhost test uploads never land where
# production looks for its files: use "localhost" here and "production" in
# Render's env vars. Values come from the Bunny.net dashboard > Storage >
# <zone> > FTP & API Access.
BUNNY_API_KEY=tobemodified
BUNNY_STORAGE_ZONE=tobemodified
BUNNY_HOSTNAME=tobemodified
BUNNY_PULL_ZONE=tobemodified
BUNNY_UPLOAD_PATH=localhost
